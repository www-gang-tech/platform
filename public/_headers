/*
  # Security headers for Cloudflare Pages / Netlify
  # HSTS: Force HTTPS for 1 year, include subdomains, opt-in to preload list
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  
  # CSP: Align with template meta policies (both are enforced together).
  # Allow cdnjs for Font Awesome on content pages; allow n8n comment webhooks.
  # TODO: Add SRI hashes via build process for CSS/JS integrity checking
  Content-Security-Policy: default-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com; img-src 'self' data: https:; font-src 'self' https://cdnjs.cloudflare.com; connect-src 'self' https://*.n8n.app https://*.n8n.io http://localhost:8000 http://127.0.0.1:8000 http://localhost:5001 http://127.0.0.1:5001; base-uri 'self'; form-action 'self' https: https://*.n8n.app https://*.n8n.io; frame-ancestors 'none'; object-src 'none'
  
  # Referrer Policy: Only send origin on cross-origin requests over HTTPS
  Referrer-Policy: strict-origin-when-cross-origin
  
  # Permissions Policy: Block access to sensitive browser APIs
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()
  
  # Prevent MIME type sniffing
  X-Content-Type-Options: nosniff
  
  # Clickjacking protection (also in CSP frame-ancestors)
  X-Frame-Options: DENY
  
  # XSS protection for legacy browsers
  X-XSS-Protection: 1; mode=block

# Cache static assets for 1 year (immutable with hashed filenames)
/assets/*
  Cache-Control: public, max-age=31536000, immutable
